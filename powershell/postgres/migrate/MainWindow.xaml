<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🐘 {L_Title}" Width="980" Height="800" MinHeight="750"
        Background="#0f172a" Foreground="#f8fafc"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        FontFamily="Segoe UI" FontSize="13">
    
    <Window.Resources>
        <!-- Styles -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="Foreground" Value="#f8fafc"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="Foreground" Value="#f8fafc"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#f8fafc"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1e293b"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563eb"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3b82f6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#059669"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#10b981"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#f8fafc"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5,15,5"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="Foreground" Value="#f8fafc"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Background="{TemplateBinding Background}" CornerRadius="4,4,0,0">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#38bdf8"/>
                                <Setter Property="Foreground" Value="#0f172a"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#334155"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.Setters>
                                    <Setter TargetName="Border" Property="Background" Value="#38bdf8"/>
                                </MultiTrigger.Setters>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>    <!-- Tabs -->
            <RowDefinition Height="Auto"/> <!-- Global Progress -->
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="0,0,0,20">
            <!-- TAB 1: MIGRATION -->
            <TabItem Header="🚀 {L_TabMigration}">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Mode -->
                        <RowDefinition Height="Auto"/> <!-- Options -->
                        <RowDefinition Height="*"/>    <!-- Split View -->
                        <RowDefinition Height="Auto"/> <!-- Action -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <Label Content="{L_Mode}"/>
                        <ComboBox Name="ComboMode" Height="30"/>
                    </StackPanel>

                    <!-- OPTIONS SECTION -->
                    <Border Grid.Row="1" Background="#1e293b" CornerRadius="6" Padding="15" Margin="0,0,0,20">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,10">
                                <CheckBox Name="ChkRoles" Content="{L_ChkRoles}"/>
                                <CheckBox Name="ChkSchemaOnly" Content="{L_SchemaOnly}"/>
                                <CheckBox Name="ChkDataOnly" Content="{L_DataOnly}"/>
                            </WrapPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Label Grid.Column="0" Content="{L_Format}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Name="ComboFormat" Grid.Column="1" Height="28"/>
                                
                                <Label Grid.Column="2" Content="{L_Jobs}" VerticalAlignment="Center" Margin="20,0,10,0"/>
                                <TextBox Name="InJobs" Grid.Column="3" Height="28" Width="60" HorizontalAlignment="Left" Text="1"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- SPLIT VIEW SECTION -->
                    <Grid Grid.Row="2" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: SOURCE -->
                        <Border Grid.Column="0" Background="#1e293b" CornerRadius="6" Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{L_SrcSection}" Foreground="#38bdf8" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                                
                                <Grid Grid.Row="1" Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="{L_Template}" VerticalAlignment="Center"/>
                                    <ComboBox Name="ComboSrcTpl" Grid.Column="1" Height="28"/>
                                </Grid>

                                <Button Name="BtnTestSrc" Grid.Row="2" Content="⚡ {L_TestSrcBtn}" Style="{StaticResource PrimaryButton}" Height="35" Margin="0,0,0,15"/>

                                <Grid Grid.Row="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Label Grid.Row="0" Content="{L_Dbs}"/>
                                    <Border Grid.Row="1" Background="#0f172a" BorderBrush="#334155" BorderThickness="1" CornerRadius="4">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <Grid Name="GridSrcDbPg" Grid.Row="0" Grid.RowSpan="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <ListBox Name="ListSrcDb" Grid.Row="0" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" SelectionMode="Multiple">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Foreground="White" Margin="2,2,0,2"/>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <Border Grid.Row="1" Background="#334155" Padding="5">
                                                    <CheckBox Name="ChkToggleDbs" Content="{L_ToggleDbs}" HorizontalAlignment="Center" Foreground="#f8fafc" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- RIGHT: TARGET -->
                        <Border Grid.Column="2" Background="#1e293b" CornerRadius="6" Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{L_TgtSection}" Foreground="#38bdf8" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                                
                                <Grid Grid.Row="1" Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="{L_Template}" VerticalAlignment="Center"/>
                                    <ComboBox Name="ComboTgtTpl" Grid.Column="1" Height="28"/>
                                </Grid>

                                <Button Name="BtnTestTgt" Grid.Row="2" Content="🔌 {L_TestTgtBtn}" Style="{StaticResource PrimaryButton}" Height="35" VerticalAlignment="Top"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- MIGRATION PROGRESS & ACTIONS -->
                    <StackPanel Grid.Row="3">
                        <Button Name="BtnRun" Content="🚀 {L_RunBtn}" Style="{StaticResource SuccessButton}" FontSize="16" FontWeight="Bold" Height="50" Margin="0,0,0,10"/>
                        <ProgressBar Name="ProgressBar" Height="10" Minimum="0" Maximum="100" BorderThickness="0" Background="#1e293b" Foreground="#10b981"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 2: SETTINGS -->
            <TabItem Header="⚙️ {L_TabSettings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel Margin="0,15,0,0">
                    <TextBlock Text="{L_GlobalSettings}" Foreground="#38bdf8" FontWeight="Bold" Margin="0,0,0,20" FontSize="16"/>
                    
                    <Border Background="#1e293b" CornerRadius="6" Padding="15" Margin="0,0,0,20">
                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <Label Content="{L_Version}"/>
                                    <ComboBox Name="ComboVersion" Height="30"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Bottom">
                                    <Button Name="BtnDl" Content="⬇️ {L_BtnDl}" Width="150" Height="30" Margin="0,0,0,5"/>
                                    <Button Name="BtnDlPgloader" Content="⬇️ pgloader &amp; mysql" Width="150" Height="30"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <Label Content="{L_File}"/>
                                    <TextBox Name="InFile" Height="30"/>
                                </StackPanel>
                                <Button Name="BtnBrowse" Grid.Column="1" Content="📂 {L_BtnBrowse}" Width="150" Height="30" VerticalAlignment="Bottom"/>
                            </Grid>
                            
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <Label Content="{L_Verify}" Foreground="#38bdf8" FontWeight="Bold" FontSize="14"/>
                                    <ComboBox Name="ComboVerify" Height="30" Background="#0f172a" Foreground="Black"/>
                                </StackPanel>
                            </Grid>

                            <CheckBox Name="ChkSavePass" Content="{L_SavePass}" Margin="0,10,0,0" FontWeight="SemiBold" Foreground="#38bdf8"/>
                        </StackPanel>
                    </Border>
                    
                    <TextBlock Text="{L_ManageTpl}" Foreground="#38bdf8" FontWeight="Bold" Margin="0,0,0,10" FontSize="16"/>
                    <Border Background="#1e293b" CornerRadius="6" Padding="15" Margin="0,0,0,20">
                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <Label Content="{L_Template}"/>
                                    <ComboBox Name="ComboManageTpl" Height="30" IsEditable="True"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0" Width="100">
                                    <Label Content="Engine"/>
                                    <ComboBox Name="ComboTplEngine" Height="30">
                                        <ComboBoxItem Content="PostgreSQL"/>
                                        <ComboBoxItem Content="MySQL"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,10,0" Width="100">
                                    <Label Content="Typ"/>
                                    <ComboBox Name="ComboTplType" Height="30">
                                        <ComboBoxItem Content="Beides"/>
                                        <ComboBoxItem Content="Quelle"/>
                                        <ComboBoxItem Content="Ziel"/>
                                    </ComboBox>
                                </StackPanel>
                                <Button Name="BtnDelTpl" Grid.Column="3" Content="🗑️ {L_BtnDelTpl}" Width="150" Height="30" VerticalAlignment="Bottom" />
                            </Grid>
                            
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="{L_Host}" VerticalAlignment="Center"/>
                                <TextBox Name="InTplHost" Grid.Column="1" Height="28" Margin="0,0,10,0"/>
                                <Label Grid.Column="2" Content="{L_Port}" VerticalAlignment="Center" Margin="10,0,10,0"/>
                                <TextBox Name="InTplPort" Grid.Column="3" Height="28"/>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="{L_User}" VerticalAlignment="Center"/>
                                <TextBox Name="InTplUser" Grid.Column="1" Height="28" Margin="0,0,10,0"/>
                                <Label Grid.Column="2" Content="{L_Pass}" VerticalAlignment="Center" Margin="10,0,10,0"/>
                                <PasswordBox Name="InTplPass" Grid.Column="3" Height="28"/>
                            </Grid>
                            
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="{L_MaintDb}" VerticalAlignment="Center"/>
                                <TextBox Name="InTplMaintDb" Grid.Column="1" Height="28"/>
                            </Grid>
                            
                            <Button Name="BtnSaveTpl" Content="💾 {L_SaveTpl}" Style="{StaticResource PrimaryButton}" Height="35"/>
                        </StackPanel>
                    </Border>
                    
                    <Button Name="BtnSave" Content="💾 {L_SaveBtn}" Height="40" Margin="0,0,0,20"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- TAB 3: LOGS -->
            <TabItem Header="📝 {L_TabLogs}">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Button Name="BtnClearLogs" Grid.Row="0" Content="{L_ClearLogs}" HorizontalAlignment="Right" Width="100" Height="28" Margin="0,0,0,10"/>
                    
                    <Border Grid.Row="1" Background="#0f172a" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,15">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox Name="TxtLog" Background="Transparent" Foreground="#a3e635" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" Padding="10" FontFamily="Consolas"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- GLOBAL STATUS -->
        <StackPanel Grid.Row="1">
            <TextBlock Name="Status" Text="{L_Ready}" TextAlignment="Center" Foreground="#94a3b8" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>