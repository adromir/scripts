<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hardware Profile Manager"
        Height="620" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E"
        Foreground="#CDD6F4"
        FontFamily="Segoe UI, Segoe UI Variable, sans-serif"
        FontSize="12">

    <Window.Resources>
        <!-- Standard Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                    <Setter Property="BorderBrush" Value="#89B4FA"/>
                    <Setter Property="Foreground" Value="#89B4FA"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#585B70"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Highlight Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="BorderBrush" Value="#89B4FA"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B4BEFE"/>
                    <Setter Property="Foreground" Value="#11111B"/>
                    <Setter Property="BorderBrush" Value="#B4BEFE"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#74C7EC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="BorderBrush" Value="#585B70"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#585B70"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- GroupBox Style -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="LblDlgTitle" Text="⚡ Hardware Performance Profile Manager" FontSize="16" FontWeight="Bold" Foreground="#89B4FA" VerticalAlignment="Center"/>
            <TextBlock x:Name="LblDlgSubtitle" Text="Configure, customize, and persist execution profiles" FontSize="11" Foreground="#A6ADC8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Content Area: Left Profile List, Right Profile Form -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Profile Selection & Management -->
            <GroupBox x:Name="GrpProfileList" Grid.Column="0" Header="Saved Profiles">
                <DockPanel>
                    <!-- Action Buttons under list -->
                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnNewProfile" Style="{StaticResource ActionButtonStyle}" Content="+ New" Grid.Column="0" Height="26" ToolTip="Create a new profile"/>
                        <Button x:Name="BtnDuplicateProfile" Style="{StaticResource ActionButtonStyle}" Content="Duplicate" Grid.Column="2" Height="26" ToolTip="Duplicate currently selected profile"/>
                        <Button x:Name="BtnDeleteProfile" Style="{StaticResource ActionButtonStyle}" Content="Delete" Grid.Column="4" Height="26" ToolTip="Delete selected profile"/>
                    </Grid>

                    <ListBox x:Name="LstProfiles" Background="#181825" BorderBrush="#45475A" Foreground="#CDD6F4" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#89B4FA" FontSize="12"/>
                                    <TextBlock Text="{Binding Description}" Foreground="#A6ADC8" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>

            <!-- Right: Profile Editor Form -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Group 1: Identity -->
                    <GroupBox x:Name="GrpProfIdentity" Header="Profile Information">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="LblProfName" Text="Profile Name:" Foreground="#CDD6F4" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtProfName" Grid.Row="0" Grid.Column="1" Height="26" Margin="0,0,0,6"/>

                            <TextBlock x:Name="LblProfDesc" Text="Description:" Foreground="#CDD6F4" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtProfDesc" Grid.Row="1" Grid.Column="1" Height="26"/>
                        </Grid>
                    </GroupBox>

                    <!-- Group 2: Core Parameters -->
                    <GroupBox x:Name="GrpProfCore" Header="Core Inference Settings">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="LblProfThreads" Text="Threads (-t):" Foreground="#CDD6F4" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtProfThreads" Grid.Column="1" Height="26" HorizontalContentAlignment="Center" Text="8"/>

                            <TextBlock x:Name="LblProfGpuLayers" Text="GPU Layers (-ngl):" Foreground="#CDD6F4" Grid.Column="3" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtProfGpuLayers" Grid.Column="4" Height="26" HorizontalContentAlignment="Center" Text="99"/>

                            <TextBlock x:Name="LblProfCtxSize" Text="Context (-c):" Foreground="#CDD6F4" Grid.Column="6" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtProfCtxSize" Grid.Column="7" Height="26" HorizontalContentAlignment="Center" Text="8192"/>
                        </Grid>
                    </GroupBox>

                    <!-- Group 3: Batching & KV-Cache -->
                    <GroupBox x:Name="GrpProfBatch" Header="Batching &amp; KV-Cache Quantization">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="LblProfBatch" Text="Batch Size (-b):" Foreground="#CDD6F4" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtProfBatch" Grid.Row="0" Grid.Column="1" Height="26" HorizontalContentAlignment="Center" Text="2048"/>

                            <TextBlock x:Name="LblProfUbatch" Text="uBatch (-ub):" Foreground="#CDD6F4" Grid.Row="0" Grid.Column="3" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtProfUbatch" Grid.Row="0" Grid.Column="4" Height="26" HorizontalContentAlignment="Center" Text="512"/>

                            <TextBlock x:Name="LblProfCacheK" Text="Cache K (-ctk):" Foreground="#CDD6F4" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbProfCacheK" Grid.Row="2" Grid.Column="1" Height="26">
                                <ComboBoxItem Content="f16 (default)" Tag="f16" IsSelected="True"/>
                                <ComboBoxItem Content="q8_0" Tag="q8_0"/>
                                <ComboBoxItem Content="q4_0" Tag="q4_0"/>
                                <ComboBoxItem Content="turbo2" Tag="turbo2"/>
                                <ComboBoxItem Content="turbo3" Tag="turbo3"/>
                                <ComboBoxItem Content="turbo4" Tag="turbo4"/>
                            </ComboBox>

                            <TextBlock x:Name="LblProfCacheV" Text="Cache V (-ctv):" Foreground="#CDD6F4" Grid.Row="2" Grid.Column="3" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbProfCacheV" Grid.Row="2" Grid.Column="4" Height="26">
                                <ComboBoxItem Content="f16 (default)" Tag="f16" IsSelected="True"/>
                                <ComboBoxItem Content="q8_0" Tag="q8_0"/>
                                <ComboBoxItem Content="q4_0" Tag="q4_0"/>
                                <ComboBoxItem Content="turbo2" Tag="turbo2"/>
                                <ComboBoxItem Content="turbo3" Tag="turbo3"/>
                                <ComboBoxItem Content="turbo4" Tag="turbo4"/>
                            </ComboBox>
                        </Grid>
                    </GroupBox>

                    <!-- Group 4: Optimization, Memory & CPU Affinity Flags -->
                    <GroupBox x:Name="GrpProfFlags" Header="Execution Flags &amp; Hardware Optimization">
                        <StackPanel>
                            <!-- Row 1: Attention & Memory -->
                            <WrapPanel Margin="0,0,0,8">
                                <CheckBox x:Name="ChkProfFlashAttn" Content="Flash Attention (-fa)" Foreground="#A6E3A1" IsChecked="True" Margin="0,0,16,4" ToolTip="Enables Flash Attention to drastically reduce VRAM footprint on long contexts and boost prompt prefill"/>
                                <CheckBox x:Name="ChkProfMlock" Content="Lock RAM (--mlock)" Foreground="#CDD6F4" IsChecked="True" Margin="0,0,16,4" ToolTip="Locks model memory in physical RAM to prevent swapping into Windows pagefile"/>
                                <CheckBox x:Name="ChkProfMmap" Content="Memory Map (--mmap)" Foreground="#CDD6F4" IsChecked="True" Margin="0,0,16,4" ToolTip="Direct memory mapping of weights for fast loading"/>
                            </WrapPanel>

                            <!-- Row 2: Universal CPU Thread Affinity -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkProfAffinity" Content="Set CPU Thread Affinity" Foreground="#89B4FA" IsChecked="False" Grid.Column="0" VerticalAlignment="Center" ToolTip="Bind worker threads to specific CPU cores or processor clusters"/>
                                <TextBox x:Name="TxtProfAffinityMask" Grid.Column="2" Height="24" Text="0xFF" HorizontalContentAlignment="Center" ToolTip="Hexadecimal CPU affinity bitmask (e.g. 0xFF for cores 0-7, 0x0F for cores 0-3, 0xFFFF for 16 cores)"/>
                                <TextBlock x:Name="LblProfAffinityHint" Text="Hex bitmask (e.g. 0xFF = cores 0–7, 0x0F = cores 0–3)" Foreground="#6C7086" FontSize="10" Grid.Column="4" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Row 3: Speculative & Experimental Decoders -->
                            <WrapPanel Margin="0,0,0,0">
                                <CheckBox x:Name="ChkProfDflash" Content="DFlash 2 Speculative (--dflash)" Foreground="#FAB387" IsChecked="False" Margin="0,0,16,2" ToolTip="Enables DFlash speculative decoding acceleration"/>
                                <CheckBox x:Name="ChkProfGdnReplay" Content="MTP Rollback (--gdn-replay)" Foreground="#FAB387" IsChecked="False" Margin="0,0,16,2" ToolTip="Enables Gated DeltaNet ingredient replay for Multi-Token Prediction"/>
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Dialog Actions -->
        <DockPanel Grid.Row="2">
            <TextBlock x:Name="TxtDlgStatus" Text="Ready." Foreground="#A6ADC8" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSaveProfileChanges" Style="{StaticResource ActionButtonStyle}" Content="Save Profile" Height="28" Width="110" Margin="0,0,8,0" ToolTip="Save changes to current profile"/>
                <Button x:Name="BtnApplyAndClose" Style="{StaticResource PrimaryButtonStyle}" Content="Apply to Main Window" Height="28" Width="160" Margin="0,0,8,0" ToolTip="Save and apply this profile to the benchmark setup"/>
                <Button x:Name="BtnCloseDialog" Style="{StaticResource ActionButtonStyle}" Content="Close" Height="28" Width="80"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
