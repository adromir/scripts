<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="MainAppWindow" Title="EXIF Geotag Tool" Height="850" Width="1200"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BgColor}"
        AllowDrop="True">
  <Window.Resources>
    <SolidColorBrush x:Key="BgColor" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="PanelBgColor" Color="#252526"/>
    <SolidColorBrush x:Key="FgColor" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="AccentColor" Color="#007ACC"/>
    <SolidColorBrush x:Key="AccentHoverColor" Color="#0098FF"/>
    <SolidColorBrush x:Key="BorderColor" Color="#3E3E42"/>
    <SolidColorBrush x:Key="LogBgColor" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="ErrorColor" Color="#F48771"/>
    <SolidColorBrush x:Key="SuccessColor" Color="#89D185"/>
    <SolidColorBrush x:Key="WarningColor" Color="#CCA700"/>
    <SolidColorBrush x:Key="CardBgColor" Color="#2D2D30"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource FgColor}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style TargetType="Label">
      <Setter Property="Foreground" Value="{DynamicResource FgColor}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource FgColor}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="Margin" Value="0,4,0,4"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource BgColor}"/>
      <Setter Property="Foreground" Value="{DynamicResource FgColor}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
      <Setter Property="Padding" Value="5"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentHoverColor}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource BorderColor}"/>
                <Setter Property="Foreground" Value="#888888"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FilterButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource BorderColor}"/>
      <Setter Property="Foreground" Value="{DynamicResource FgColor}"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource FgColor}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Grid Margin="0,0,2,0">
              <Border x:Name="HoverBorder" Background="{DynamicResource BorderColor}" CornerRadius="4,4,0,0" Opacity="0"/>
              <Border x:Name="SelectedBorder" Background="{DynamicResource PanelBgColor}" BorderBrush="{DynamicResource AccentColor}" BorderThickness="0,0,0,3" CornerRadius="4,4,0,0" Opacity="0"/>
              <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="15,10"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HoverBorder" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="SelectedBorder" Property="Opacity" Value="1"/>
                <Setter TargetName="HoverBorder" Property="Opacity" Value="0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <DockPanel>
    <!-- Status Bar (defined first, docked to bottom) -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBgColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Height="24">
      <Grid Margin="10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="ExiftoolVersionBar" Grid.Column="0" Text="ExifTool: checking..." VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource WarningColor}"/>
        <TextBlock x:Name="StatusBarText" Grid.Column="2" Text="" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource FgColor}"/>
      </Grid>
    </Border>

    <!-- TabControl (defined last, no Dock property, fills all remaining space) -->
    <TabControl Margin="10,10,10,0" Background="Transparent" BorderThickness="0">
      <!-- Workspace Tab -->
      <TabItem x:Name="WorkspaceTabItem">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z" Fill="{DynamicResource FgColor}" Width="14" Height="14" Margin="0,0,8,0" Stretch="Uniform"/>
            <TextBlock x:Name="WorkspaceTitleText" Text="Processing Workspace" FontWeight="SemiBold" FontSize="14"/>
          </StackPanel>
        </TabItem.Header>
        <Grid Margin="15">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Header -->
          <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Ready to Process" FontSize="18" FontWeight="Bold"/>
            <Button x:Name="ThemeToggleButton" Grid.Column="1" Background="{DynamicResource BorderColor}" Padding="8,4">
              <StackPanel Orientation="Horizontal">
                <Path Data="M12,2A7,7 0 0,0 5,12A7,7 0 0,0 12,19V2Z" Fill="{DynamicResource FgColor}" Width="14" Height="14" Margin="0,0,6,0" Stretch="Uniform"/>
                <TextBlock x:Name="ThemeToggleText" Text="Theme" VerticalAlignment="Center" FontSize="12"/>
              </StackPanel>
            </Button>
          </Grid>

          <!-- Folder Selection -->
          <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Label x:Name="TargetFolderLabel" Grid.Row="0" Content="Target Folder:" Padding="0,0,0,2"/>
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="TargetFolderTextBox" Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center" Height="30" AllowDrop="True" ToolTip="Drop a folder here or use Browse"/>
              <Button x:Name="BrowseFolderButton" Grid.Column="1" Width="95" Height="30">
                <StackPanel Orientation="Horizontal">
                  <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z" Fill="White" Width="12" Height="12" Margin="0,0,5,0" Stretch="Uniform"/>
                  <TextBlock x:Name="BrowseBtnText" Text="Browse..." VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
              </Button>
            </Grid>
          </Grid>

          <!-- Processing Options -->
          <WrapPanel Grid.Row="2" Margin="0,0,0,8" Orientation="Horizontal">
            <CheckBox x:Name="RecursiveCheckBox" Content="Include Subfolders" Margin="0,0,20,0"/>
            <CheckBox x:Name="DryRunCheckBox" Content="Dry-Run (no changes)" Margin="0,0,20,0"/>
            <CheckBox x:Name="PhotonOnlyCheckBox" Content="Photon-Only (skip Dawarich)" Margin="0,0,0,0"/>
          </WrapPanel>

          <!-- Start / Cancel Buttons -->
          <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="StartProcessingButton" Grid.Column="0" Height="40" FontSize="14" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <Path x:Name="StartIcon" Data="M8,5.14V19.14L19,12.14L8,5.14Z" Fill="White" Width="16" Height="16" Margin="0,0,8,0" Stretch="Uniform"/>
                <TextBlock x:Name="StartProcessingText" Text="Start Processing" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="CancelProcessingButton" Grid.Column="1" Height="40" FontSize="14" Background="#D13438" IsEnabled="False">
              <StackPanel Orientation="Horizontal">
                <Path x:Name="CancelIcon" Data="M6,6H18V18H6V6Z" Fill="White" Width="16" Height="16" Margin="0,0,8,0" Stretch="Uniform"/>
                <TextBlock x:Name="CancelProcessingText" Text="Cancel" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>

          <!-- Stats Bar -->
          <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource CardBgColor}" CornerRadius="4" Margin="0,0,4,0" Padding="10,6">
              <StackPanel>
                <TextBlock x:Name="StatUpdatedLbl" Text="Updated" FontSize="10" Foreground="{DynamicResource SuccessColor}"/>
                <TextBlock x:Name="StatUpdatedVal" Text="0" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SuccessColor}"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource CardBgColor}" CornerRadius="4" Margin="4,0,4,0" Padding="10,6">
              <StackPanel>
                <TextBlock x:Name="StatWarningsLbl" Text="Warnings" FontSize="10" Foreground="{DynamicResource WarningColor}"/>
                <TextBlock x:Name="StatWarningsVal" Text="0" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource WarningColor}"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource CardBgColor}" CornerRadius="4" Margin="4,0,4,0" Padding="10,6">
              <StackPanel>
                <TextBlock x:Name="StatSkippedLbl" Text="Skipped" FontSize="10" Foreground="{DynamicResource FgColor}"/>
                <TextBlock x:Name="StatSkippedVal" Text="0" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource FgColor}"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="{DynamicResource CardBgColor}" CornerRadius="4" Margin="4,0,0,0" Padding="10,6">
              <StackPanel>
                <TextBlock x:Name="StatRemainingLbl" Text="Remaining" FontSize="10" Foreground="{DynamicResource AccentColor}"/>
                <TextBlock x:Name="StatRemainingVal" Text="0" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Log Filter Toolbar -->
          <Grid Grid.Row="5" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="LogFilterAllBtn" Grid.Column="0" Style="{StaticResource FilterButtonStyle}" Content="All" Margin="0,0,4,0" Tag="All"/>
            <Button x:Name="LogFilterWarnBtn" Grid.Column="1" Style="{StaticResource FilterButtonStyle}" Content="⚠ Warnings" Margin="0,0,4,0" Tag="Warning"/>
            <Button x:Name="LogFilterErrBtn"  Grid.Column="2" Style="{StaticResource FilterButtonStyle}" Content="✖ Errors" Margin="0,0,4,0" Tag="Error"/>
            <Button x:Name="LogFilterSkipBtn" Grid.Column="3" Style="{StaticResource FilterButtonStyle}" Content="⏭ Skipped" Tag="Skipped"/>
            <Button x:Name="ExportReportButton" Grid.Column="5" Style="{StaticResource FilterButtonStyle}" Content="📄 Export Report" IsEnabled="False"/>
          </Grid>

          <!-- Log Output -->
          <Border Grid.Row="6" Background="{DynamicResource LogBgColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4">
            <RichTextBox x:Name="LogRichTextBox" Background="Transparent" Foreground="{DynamicResource FgColor}" BorderThickness="0" FontFamily="Consolas" FontSize="12" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Padding="8">
              <FlowDocument>
                <Paragraph x:Name="LogParagraph"/>
              </FlowDocument>
            </RichTextBox>
          </Border>

          <!-- Progress Bar -->
          <StackPanel Grid.Row="7" Margin="0,8,0,0">
            <Grid Margin="0,0,0,4">
              <TextBlock x:Name="ProgressStatusText" Text="Ready." HorizontalAlignment="Left" FontSize="11"/>
              <TextBlock x:Name="ProgressPercentText" Text="0%" HorizontalAlignment="Right" FontSize="11"/>
            </Grid>
            <ProgressBar x:Name="MainProgressBar" Height="16" Minimum="0" Maximum="100" Value="0" Background="{DynamicResource PanelBgColor}" Foreground="{DynamicResource AccentColor}" BorderBrush="{DynamicResource BorderColor}"/>
          </StackPanel>
        </Grid>
      </TabItem>
      <!-- Settings Tab -->
      <TabItem x:Name="SettingsTabItem">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.98C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11.02C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.98L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98Z" Fill="{DynamicResource FgColor}" Width="14" Height="14" Margin="0,0,8,0" Stretch="Uniform"/>
            <TextBlock x:Name="SettingsTitleText" Text="Settings" FontWeight="SemiBold" FontSize="14"/>
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
          <Grid MaxWidth="900" HorizontalAlignment="Stretch" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Dawarich URL -->
            <Label x:Name="DawarichUrlLabel" Grid.Row="0" Grid.Column="0" Content="Dawarich API URL:" VerticalAlignment="Center"/>
            <TextBox x:Name="DawarichApiUrlTextBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,12" VerticalContentAlignment="Center" Height="30"/>

            <!-- Dawarich Key -->
            <Label x:Name="DawarichKeyLabel" Grid.Row="1" Grid.Column="0" Content="Dawarich API Key:" VerticalAlignment="Center"/>
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,4,8,12">
              <TextBox x:Name="DawarichApiKeyTextBox" VerticalContentAlignment="Center" Height="30" Padding="5,0,30,0"/>
              <Ellipse x:Name="DawarichStatusDot" Width="10" Height="10" Fill="#888888" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="API Status"/>
            </Grid>
            <Button x:Name="TestDawarichButton" Grid.Row="1" Grid.Column="2" Margin="0,4,0,12" Height="30">
              <StackPanel Orientation="Horizontal">
                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" Fill="White" Width="12" Height="12" Margin="0,0,4,0" Stretch="Uniform"/>
                <TextBlock x:Name="TestDawarichText" Text="Test API" VerticalAlignment="Center" FontSize="11"/>
              </StackPanel>
            </Button>

            <!-- Photon URL -->
            <Label x:Name="PhotonUrlLabel" Grid.Row="2" Grid.Column="0" Content="Photon API URL:" VerticalAlignment="Center"/>
            <Grid Grid.Row="2" Grid.Column="1" Margin="0,4,8,12">
              <TextBox x:Name="PhotonApiUrlTextBox" VerticalContentAlignment="Center" Height="30" Padding="5,0,30,0"/>
              <Ellipse x:Name="PhotonStatusDot" Width="10" Height="10" Fill="#888888" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="API Status"/>
            </Grid>
            <Button x:Name="TestPhotonButton" Grid.Row="2" Grid.Column="2" Margin="0,4,0,12" Height="30">
              <StackPanel Orientation="Horizontal">
                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" Fill="White" Width="12" Height="12" Margin="0,0,4,0" Stretch="Uniform"/>
                <TextBlock x:Name="TestPhotonText" Text="Test API" VerticalAlignment="Center" FontSize="11"/>
              </StackPanel>
            </Button>

            <!-- Time Window -->
            <Label x:Name="TimeWindowLabel" Grid.Row="3" Grid.Column="0" Content="API Time Window (sec):" VerticalAlignment="Center"/>
            <TextBox x:Name="TimeWindowTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" Width="120" Margin="0,4,0,12" VerticalContentAlignment="Center" Height="30"/>

            <!-- API Timeout and Retry -->
            <Label x:Name="ApiTimeoutLabel" Grid.Row="4" Grid.Column="0" Content="API Timeout (sec):" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,12">
              <TextBox x:Name="ApiTimeoutTextBox" Width="80" VerticalContentAlignment="Center" Height="30" Margin="0,0,20,0"/>
              <Label x:Name="RetryCountLabel" Content="Retry Count:" VerticalAlignment="Center" Padding="0,0,8,0"/>
              <TextBox x:Name="RetryCountTextBox" Width="60" VerticalContentAlignment="Center" Height="30"/>
            </StackPanel>

            <!-- Exiftool Path -->
            <Label x:Name="ExiftoolPathLabel" Grid.Row="5" Grid.Column="0" Content="Exiftool Path:" VerticalAlignment="Center"/>
            <TextBox x:Name="ExiftoolPathTextBox" Grid.Row="5" Grid.Column="1" Margin="0,4,8,12" VerticalContentAlignment="Center" Height="30"/>
            <Button x:Name="BrowseExiftoolButton" Grid.Row="5" Grid.Column="2" Margin="0,4,0,12" Height="30">
              <StackPanel Orientation="Horizontal">
                <Path Data="M13,9H18.5L13,3.5V9M6,2H14L20,8V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V4C4,2.89 4.89,2 6,2Z" Fill="White" Width="12" Height="12" Margin="0,0,4,0" Stretch="Uniform"/>
                <TextBlock Text="Browse..." VerticalAlignment="Center" FontSize="11"/>
              </StackPanel>
            </Button>

            <!-- Exiftool Version -->
            <Label x:Name="ExiftoolVersionLabel" Grid.Row="6" Grid.Column="0" Content="Exiftool Version:" VerticalAlignment="Center"/>
            <TextBlock x:Name="ExiftoolVersionText" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Text="(not detected)" VerticalAlignment="Center" Margin="0,4,0,12" Foreground="{DynamicResource WarningColor}"/>

            <!-- Checkboxes -->
            <StackPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12">
              <CheckBox x:Name="OverwriteCheckBox" Content="Overwrite existing GPS/Location data" Margin="0,0,0,4"/>
              <CheckBox x:Name="AlwaysQueryPhotonCheckBox" Content="Always query Photon API (Images)" Margin="0,0,0,4"/>
              <CheckBox x:Name="MinimizeTrayCheckBox" Content="Minimize to System Tray" Margin="0,0,0,0"/>
            </StackPanel>

            <!-- Fallback Date Source -->
            <Label x:Name="FallbackMethodLabel" Grid.Row="8" Grid.Column="0" Content="Fallback Date Source:" VerticalAlignment="Center" ToolTip="Used when EXIF has no creation date."/>
            <ComboBox x:Name="FallbackMethodComboBox" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" Width="200" Margin="0,4,0,12" Height="30" VerticalContentAlignment="Center">
              <ComboBoxItem Content="Filename Pattern" Tag="Filename"/>
              <ComboBoxItem Content="File System Date" Tag="FileSystem"/>
            </ComboBox>

            <!-- Filename Patterns -->
            <Label x:Name="FilenamePatternLabel" Grid.Row="9" Grid.Column="0" Content="Filename Patterns (Regex):" VerticalAlignment="Top" Margin="0,8,0,0" ToolTip="One regex per line. EXIF is always checked first."/>
            <TextBox x:Name="FilenamePatternTextBox" Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,12"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Height="100" VerticalContentAlignment="Top" Padding="5"
                     FontFamily="Consolas" FontSize="11"/>

            <!-- Pattern Tester -->
            <Label x:Name="PatternTestLabel" Grid.Row="10" Grid.Column="0" Content="Pattern Tester:" VerticalAlignment="Center" ToolTip="Type a filename to test your patterns."/>
            <Grid Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="PatternTestInputBox" Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center" Height="30" FontFamily="Consolas" FontSize="11" ToolTip="Enter a sample filename to test against saved patterns"/>
              <Button x:Name="PatternTestButton" Grid.Column="1" Width="70" Height="30">
                <TextBlock Text="Test" VerticalAlignment="Center" FontSize="12"/>
              </Button>
            </Grid>
            <TextBlock x:Name="PatternTestResult" Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2,0,12" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource WarningColor}"/>

            <!-- Date Range Filter -->
            <Label x:Name="DateFromLabel" Grid.Row="12" Grid.Column="0" Content="Filter: Date From:" VerticalAlignment="Center" ToolTip="Only process files with timestamps within this range."/>
            <StackPanel Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,12">
              <DatePicker x:Name="DateFromPicker" Width="160" Height="30" VerticalContentAlignment="Center"/>
              <Label x:Name="DateToLabel" Content="To:" VerticalAlignment="Center" Padding="12,0,8,0"/>
              <DatePicker x:Name="DateToPicker" Width="160" Height="30" VerticalContentAlignment="Center"/>
            </StackPanel>

            <!-- File Extensions -->
            <Label x:Name="FileExtensionsLabel" Grid.Row="13" Grid.Column="0" Content="File Extensions:" VerticalAlignment="Center" ToolTip="Comma-separated list of extensions to process."/>
            <TextBox x:Name="FileExtensionsTextBox" Grid.Row="13" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,12" VerticalContentAlignment="Center" Height="30" FontFamily="Consolas" FontSize="11"/>

            <!-- Language -->
            <Label x:Name="LanguageLabel" Grid.Row="14" Grid.Column="0" Content="Language:" VerticalAlignment="Center"/>
            <ComboBox x:Name="LanguageComboBox" Grid.Row="14" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" Width="130" Foreground="Black" Margin="0,4,0,20" Height="30" Padding="5">
              <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                  <Setter Property="Foreground" Value="Black"/>
                </Style>
              </ComboBox.ItemContainerStyle>
            </ComboBox>

            <!-- Save Button -->
            <StackPanel Grid.Row="15" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left">
              <Button x:Name="SaveSettingsButton" Height="38" Width="170">
                <StackPanel Orientation="Horizontal">
                  <Path Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z" Fill="White" Width="14" Height="14" Margin="0,0,8,0" Stretch="Uniform"/>
                  <TextBlock x:Name="SaveSettingsBtnText" Text="Save Settings" VerticalAlignment="Center" FontSize="13"/>
                </StackPanel>
              </Button>
              <TextBlock x:Name="SaveSettingsStatus" Foreground="{DynamicResource SuccessColor}" Margin="0,4,0,0" HorizontalAlignment="Center" Visibility="Hidden" Text="Saved!"/>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
